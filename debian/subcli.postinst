#!/bin/sh
set -e

case "$1" in
    configure)
        # Enable systemd service on new installs only
        if [ "$2" = "" ] && [ -d /run/systemd/system ]; then
            deb-systemd-helper enable subcli-daemon.service >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac
